# Screenshots and render sheets. Thousands of PNGs from the visual review —
# they are evidence for a decision already made, not part of the project, and
# they are what makes the scratch directory 60MB.
.p3/**/*.png
.p3/*.png
.p3/**/*.html
.p3/*.html
.p3/*.json
.p3/appcheck.tmp.js
.p3/v02*.bak.js
.p3/v02.*.js
.p3/tmp.*

# node, editor, OS noise
node_modules/
.DS_Store
Thumbs.db
*.log

# headless-Chrome working files; created and swept by tools/scratch.js
.scratch/

# built artifacts are regenerated by tools/build-v02.js
editor.html
_site/

# wrangler's local cache. It is a build artifact, and the copy that was
# tracked carried the Cloudflare account id and the account email into a
# PUBLIC repository. Neither is a credential — an account id is routinely
# written into wrangler.toml and can do nothing without an API token — but an
# email address is personal data and had no reason to be there.
.wrangler/
